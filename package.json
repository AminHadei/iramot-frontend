{
  "name": "irmot",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build": "nuxt build",
    "dev": "TMPDIR=/tmp nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "spellcheck": "cspell --no-progress --no-summary \"**/*.{ts,js,vue,mjs,cjs,md,css,json,yml,yaml}\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format && pnpm spellcheck",
    "check:fix": "pnpm lint:fix && pnpm format:fix && pnpm check",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status --verbose",
    "css:ifp": "node tools/css/build-ifp-rtl.mjs",
    "visual:ifp": "node tools/visual/compare-ifp.mjs"
  },
  "dependencies": {
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@nuxt/content": "^3.16.2",
    "@nuxt/image": "^2.2.0",
    "better-sqlite3": "^13.0.3",
    "nuxt": "^4.6.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rtlcss": "^4.3.0",
    "tailwindcss": "~3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vue-tsc": "^2.2.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "*.{js,ts,vue,json,md,css,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  }
}
