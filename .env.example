# Origin the browser uses for API calls. Required.
NUXT_PUBLIC_API_BASE=https://api.example.com

# Origin the Nuxt server uses for API calls on the same machine.
# Empty falls back to NUXT_PUBLIC_API_BASE.
# Example on one VPS: http://127.0.0.1:4000
NUXT_API_BASE_INTERNAL=http://127.0.0.1:4000

# Bind address and port of the Nuxt server.
HOST=0.0.0.0
PORT=3000

# Skip the Nuxt telemetry prompt in CI, Docker, and production.
NUXT_TELEMETRY_DISABLED=1
